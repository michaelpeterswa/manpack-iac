<?xml version="1.0" encoding="utf-8"?>
<!-- Apply with: choco install choco-packages.config -y -->
<packages>
  <!-- Not in WinGet -->
  <package id="jtalert" />
  <package id="n1mm" />
  <package id="mmsstv" />
  <!-- chirp.install is approved but unlisted; choco only installs unlisted
       packages by exact version. Check community.chocolatey.org/packages/chirp.install
       for newer versions. -->
  <package id="chirp.install" version="2026.1.9" />

  <!-- In WinGet, but those manifests point at deleted installers (HTTP 404) -->
  <package id="fldigi" />
  <package id="flrig" />
  <package id="log4om" />
</packages>
